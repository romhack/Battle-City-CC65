# ---------------------------------------------------------------------------
# Build output - all regenerated by compile.bat
# ---------------------------------------------------------------------------
build/
*.o
*.map
*.dbg
*.deb
labels.txt

# ---------------------------------------------------------------------------
# Data extracted from the original ROM by tools/extract_assets.py.
# Currently assets/graphics.chr and assets/levels.bin.
# Copyrighted: these files are created locally on every machine and must
# never be committed or redistributed.
# ---------------------------------------------------------------------------
/assets/*.chr
/assets/*.bin

# ---------------------------------------------------------------------------
# The original ROM itself (any dump), wherever the user keeps it.
# rom/ is kept as an empty placeholder folder: git stores files, not folders,
# so .gitkeep is what makes it appear in a fresh clone.  Everything else in
# there is ignored - note the /* form, a bare /rom/ would exclude the folder
# itself and the ! rule below would stop working.
# ---------------------------------------------------------------------------
*.nes
/rom/*
!/rom/.gitkeep
/roms/

# ---------------------------------------------------------------------------
# Documentation WIP
# ---------------------------------------------------------------------------
/doc/
